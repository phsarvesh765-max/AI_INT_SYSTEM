# ==============================================================================
# SMART HIRE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual keys.
# NEVER commit your actual .env file with secrets into version control.

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Relay Configuration (Used for candidate verification OTPs & roadmaps)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# IMPORTANT: If using Gmail, use a 16-character Google App Password, NOT your regular password
SMTP_PASS=your_google_app_password_here
